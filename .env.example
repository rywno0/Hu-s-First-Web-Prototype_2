# ==============================================================================
# 여운 감성 분석기 환경 변수 설정 예시 (.env.example)
# ==============================================================================
# 주의: 이 파일은 설정 템플릿(공개용)입니다. 실제 비밀 키 값을 여기에 적지 마세요.
# 실제 비밀 키는 .env 파일에 입력해야 하며, .env 파일은 .gitignore에 의해 보호됩니다.

# ------------------------------------------------------------------------------
# 1. OpenAI API 설정 (필수)
# ------------------------------------------------------------------------------
# OpenAI 대시보드(https://platform.openai.com/api-keys)에서 발급받은 비밀 API 키입니다.
# 서버 측(api/analyze.js)에서만 안전하게 사용되며, 브라우저에는 절대 노출되지 않습니다.
OPENAI_API_KEY=your_openai_api_key_here

# 감성 분석에 사용할 OpenAI 모델명입니다. (기본 권장: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. Supabase 설정 (선택 / 추후 데이터베이스 연동 확장용)
# ------------------------------------------------------------------------------
# Supabase 대시보드(Project Settings -> API)에서 확인할 수 있는 프로젝트 URL입니다.
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase 공개 익명 키(Public Anon Key)입니다.
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase 서비스 롤 비밀 키(Service Role Key)입니다.
# 관리자 권한을 가지므로 서버 사이드에서만 안전하게 보관해야 합니다.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

