@echo off
chcp 65001 > nul
title 여운 감성 분석기 - Vercel 인터넷 무료 배포 도구

echo ==============================================================================
echo 🌐 [여운 감성 분석기] Vercel 무료 인터넷 배포를 시작합니다!
echo ==============================================================================
echo.
echo * 별도의 Git 설치 없이도 Vercel 클라우드로 안전하게 업로드됩니다.
echo * 잠시 후 브라우저가 열리면 Vercel 계정(GitHub / Google 등)으로 로그인해 주세요.
echo * 터미널에서 물어보는 질문들은 키보드의 [Enter]를 누르시면 기본값으로 자동 진행됩니다.
echo.
echo ==============================================================================
echo.

REM 1. Node.js 경로를 환경 변수에 자동으로 등록합니다.
set "PATH=C:\Program Files\nodejs;%PATH%"

REM 2. Vercel 배포 도구 실행
npx.cmd vercel

echo.
echo ==============================================================================
echo 🎉 배포 작업이 완료되었습니다!
echo 상단에 출력된 프로덕션 URL 주소를 브라우저나 스마트폰에서 열어보세요.
echo ==============================================================================
echo.
pause

